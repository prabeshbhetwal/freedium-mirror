{
  "manifest_version": 3,
  "name": "Freedium Mirror Opener",
  "version": "1.0.1",
  "description": "Click to open HTTPS Medium pages on Freedium mirror.",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open in Freedium Mirror"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
